# Database (Optional - can use MongoDB Instead)
DATABASE_URL=postgresql://mimi:password@localhost:5432/gamification

# Redis
REDIS_URL=redis://localhost:6379

# Message Queue (RabbitMQ or Redis Streams)
# Option 1: RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Option 2: Redis Streams
REDIS_STREAMS_ENABLED=false

# Service Port
SERVICE_PORT=3002

# Environment
NODE_ENV=development
